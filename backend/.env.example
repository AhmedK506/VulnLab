# Copy this file to ".env" and fill in your real values.
# The .env file is read at startup and should NEVER be committed to git.

# ---- Database ----
# Native PostgreSQL on Windows. After installing PostgreSQL and creating
# a database named "vulnlab", your string looks like:
#   postgresql+psycopg2://USER:PASSWORD@localhost:5432/vulnlab
# The default superuser is "postgres" and you set its password during install.
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/vulnlab

# ---- Auth ----
# Secret used to sign login tokens. Change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24

# ---- Server ----
PORT=5000
# Your React dev server origin, so the browser is allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# ---- ZAP (Stage 2 — not used yet) ----
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# ---- Email (Stage 3) ----
# Using Mailtrap (a safe fake inbox for testing). Sign up free at
# https://mailtrap.io -> Email Testing -> Inboxes -> your inbox -> SMTP Settings,
# choose "SMTP" and copy the credentials into the four lines below.
# If you leave these blank, scans still work but no email is sent.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM=vulnlab@demo.local

# ---- AI explanations (Stage 4) ----
# Free Gemini key (no credit card): https://aistudio.google.com/app/apikey
# If left blank, reports still work using basic descriptions (graceful fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
